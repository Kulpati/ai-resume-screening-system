# Copy to .env and fill in. Without DATABASE_URL the app uses local SQLite (app.db).
DATABASE_URL=sqlite:///./app.db
# For PostgreSQL (docker-compose sets this automatically):
# DATABASE_URL=postgresql://app:app@localhost:5432/resume_screener
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email OTP verification - OFF by default so the demo never blocks.
# Set OTP_ENABLED=true and fill SMTP to actually email codes
# (for Gmail, SMTP_HOST=smtp.gmail.com and SMTP_PASSWORD is an App Password).
OTP_ENABLED=false
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
